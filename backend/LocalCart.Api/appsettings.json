{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "LocalCart.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://local-cart-six.vercel.app"
    ]
  },
  "CatalogImport": {
    "FilePath": "../../demo_marts_data_v4.csv"
  },
  "ConnectionStrings": {
    "DefaultConnection": "[STORED_IN_USER_SECRETS]"
  },
  "JwtSettings": {
    "Issuer": "LocalCart.Api",
    "Audience": "LocalCart.Web",
    "SecretKey": "[STORED_IN_USER_SECRETS]",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  }
}
